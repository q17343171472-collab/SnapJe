<?xml version="1.0" encoding="utf-8"?>
<!--
    SnapJe! App Icon Foreground
    Modern camera shutter design with photo frame elements
    Represents photography, gallery, and snapshot functionality
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <group android:scaleX="0.9"
        android:scaleY="0.9"
        android:translateX="5.4"
        android:translateY="5.4">
        
        <!-- Outer photo frame border -->
        <path
            android:pathData="M32,36 L76,36 L76,76 L32,76 Z"
            android:strokeWidth="2"
            android:strokeColor="#FF6B6B">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="32"
                    android:startY="36"
                    android:endX="76"
                    android:endY="76">
                    <item
                        android:offset="0"
                        android:color="#FF6B6B" />
                    <item
                        android:offset="1"
                        android:color="#FF8E53" />
                </gradient>
            </aapt:attr>
        </path>
        
        <!-- Inner photo frame (filled) -->
        <path
            android:pathData="M35,39 L73,39 L73,73 L35,73 Z"
            android:fillColor="#1A1A2E" />
        
        <!-- Camera shutter aperture blades (6 blades forming a circle) -->
        <group android:pivotX="54" android:pivotY="56">
            <!-- Blade 1 -->
            <path
                android:pathData="M54,42 L58,52 L50,52 Z"
                android:strokeWidth="1.5"
                android:strokeColor="#4ECDC4">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="54"
                        android:startY="42"
                        android:endX="54"
                        android:endY="52">
                        <item
                            android:offset="0"
                            android:color="#4ECDC4" />
                        <item
                            android:offset="1"
                            android:color="#45B7AA" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>
        
        <group android:pivotX="54" android:pivotY="56">
            <rotate android:fromDegrees="60">
                <!-- Blade 2 -->
                <path
                    android:pathData="M54,42 L58,52 L50,52 Z"
                    android:strokeWidth="1.5"
                    android:strokeColor="#4ECDC4">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="54"
                            android:startY="42"
                            android:endX="54"
                            android:endY="52">
                            <item
                                android:offset="0"
                                android:color="#4ECDC4" />
                            <item
                                android:offset="1"
                                android:color="#45B7AA" />
                        </gradient>
                    </aapt:attr>
                </path>
            </rotate>
        </group>
        
        <group android:pivotX="54" android:pivotY="56">
            <rotate android:fromDegrees="120">
                <!-- Blade 3 -->
                <path
                    android:pathData="M54,42 L58,52 L50,52 Z"
                    android:strokeWidth="1.5"
                    android:strokeColor="#4ECDC4">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="54"
                            android:startY="42"
                            android:endX="54"
                            android:endY="52">
                            <item
                                android:offset="0"
                                android:color="#4ECDC4" />
                            <item
                                android:offset="1"
                                android:color="#45B7AA" />
                        </gradient>
                    </aapt:attr>
                </path>
            </rotate>
        </group>
        
        <group android:pivotX="54" android:pivotY="56">
            <rotate android:fromDegrees="180">
                <!-- Blade 4 -->
                <path
                    android:pathData="M54,42 L58,52 L50,52 Z"
                    android:strokeWidth="1.5"
                    android:strokeColor="#4ECDC4">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="54"
                            android:startY="42"
                            android:endX="54"
                            android:endY="52">
                            <item
                                android:offset="0"
                                android:color="#4ECDC4" />
                            <item
                                android:offset="1"
                                android:color="#45B7AA" />
                        </gradient>
                    </aapt:attr>
                </path>
            </rotate>
        </group>
        
        <group android:pivotX="54" android:pivotY="56">
            <rotate android:fromDegrees="240">
                <!-- Blade 5 -->
                <path
                    android:pathData="M54,42 L58,52 L50,52 Z"
                    android:strokeWidth="1.5"
                    android:strokeColor="#4ECDC4">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="54"
                            android:startY="42"
                            android:endX="54"
                            android:endY="52">
                            <item
                                android:offset="0"
                                android:color="#4ECDC4" />
                            <item
                                android:offset="1"
                                android:color="#45B7AA" />
                        </gradient>
                    </aapt:attr>
                </path>
            </rotate>
        </group>
        
        <group android:pivotX="54" android:pivotY="56">
            <rotate android:fromDegrees="300">
                <!-- Blade 6 -->
                <path
                    android:pathData="M54,42 L58,52 L50,52 Z"
                    android:strokeWidth="1.5"
                    android:strokeColor="#4ECDC4">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="54"
                            android:startY="42"
                            android:endX="54"
                            android:endY="52">
                            <item
                                android:offset="0"
                                android:color="#4ECDC4" />
                            <item
                                android:offset="1"
                                android:color="#45B7AA" />
                        </gradient>
                    </aapt:attr>
                </path>
            </rotate>
        </group>
        
        <!-- Center circle of shutter -->
        <path
            android:pathData="M54,56m-6,0a6,6 0,1 1,12 0a6,6 0,1 1,-12 0"
            android:fillColor="#FFE66D" />
        
        <!-- Sparkle/star effect (representing "snap" moment) -->
        <path
            android:pathData="M70,42 L72,46 L76,46 L73,49 L74,53 L70,50 L66,53 L67,49 L64,46 L68,46 Z"
            android:fillColor="#FFE66D" />
        
    </group>
</vector>
